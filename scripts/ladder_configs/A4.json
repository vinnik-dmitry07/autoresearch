{
  "schema_version": 1,
  "max_rounds": 20,
  "K": 2,
  "cost_cap_usd": 5.0,
  "run_dir": null,
  "skip_build": false,
  "agent": "cursor_cli",
  "allowlist": ["durak/src/strategy_heuristic.cpp"],
  "gates": {"search": "quick", "holdout": "dual", "full": "full"},
  "keep_rule": {"search_delta": 0.005},
  "promotion": {"holdout_trigger_delta": 0.006, "holdout_trigger_b4_delta": 0.005},
  "engine": "map_elites",
  "selector": "score_child_prop",
  "selector_scale": 10.0,
  "selector_topk": 3,
  "nonconfirm_penalty": 0.98,
  "min_rounds": 0,
  "use_worktrees": false,
  "hygiene_enabled": true,
  "stale_min_idle_rounds": 8,
  "backup_keep": 10,
  "convergence": {"enabled": false, "min_rounds": 0, "patience": 6},
  "meta": {"every": 0, "target": "evolve/mechanism/evolve_skill.md"},
  "descriptor": {"kind": "feature", "shadow": true, "seeds": 1500, "columns": []},
  "novelty": {"lambda": 0.0, "k": 3},
  "map_elites": {"bins": 5, "dims": [2, 3, 5], "robust": true},
  "select_policy": "evolve/select_policy.json",
  "baseline": {"best_search": 0.0, "best_b4": 0.0, "best_lower_ci": 0.0},
  "leak_policy": {"enabled": true, "stop_after_hits": 0},
  "session": {
    "max_turns": 12,
    "token_cap": 60000,
    "wall_timeout_s": 900.0,
    "thinking_level": "medium",
    "model": "auto",
    "cost_per_session_usd": 0.0
  }
}
